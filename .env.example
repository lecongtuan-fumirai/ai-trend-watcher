# ==========================================
# AI Trend Watcher Environment Configuration
# ==========================================

# 1. AI API Key (Chỉ cần 1 key duy nhất)
# Hỗ trợ: "gemini" (mặc định - khuyên dùng vì context lớn & miễn phí/rẻ) hoặc "openai"
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here

# Tuỳ chọn model (để trống sẽ dùng mặc định tốt nhất)
# Với Gemini: gemini-2.5-flash hoặc gemini-2.0-flash
# Với OpenAI: gpt-4o-mini hoặc gpt-4o
AI_MODEL=gemini-2.5-flash

# OpenAI Base URL (nếu bạn dùng OpenAI-compatible như DeepSeek, Groq, OpenRouter)
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# 2. Google Chat Incoming Webhook URL
# Lấy từ Google Chat Space -> Space Settings -> Apps & Integrations -> Webhooks
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/XXXX/messages?key=YYYY&token=ZZZZ

# 3. Giới hạn số bài chất lượng nhất mỗi nguồn (mặc định: 10)
TOP_K_PER_SOURCE=10

# 4. Ngôn ngữ output (vi hoặc en)
LANGUAGE=vi
